// handeye.win32.rc - icon and version info embedded into handeye.exe
// Keep this file pure ASCII; rc.exe is picky about codepages.

#include <winver.h>

#define IDI_APP 101

IDI_APP ICON "handeye.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "handeye"
            VALUE "FileDescription",  "handeye - screen perception and control for AI agents"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "handeye"
            VALUE "OriginalFilename", "handeye.exe"
            VALUE "ProductName",      "handeye"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
